PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres.your-project:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Email Notifications (Resend - Tech Spec §2, §7.4)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
CONTACT_FORM_RECIPIENT_EMAIL=contact@campaign.upsa.edu.gh
VOLUNTEER_RECIPIENT_EMAIL=volunteer@campaign.upsa.edu.gh

# Rate Limiting & Bot Protection (Arcjet / Upstash Redis - Tech Spec §2, §7.3)
ARCJET_KEY=your-arcjet-key
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
